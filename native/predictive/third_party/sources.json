  {
    "repository": "szcompressor/SZ3",
    "sha": "db2eca3ea8ae526ee1328649a1caf1a691b45873",
    "license": "BSD-3-Clause",
    "local_files_sha256": {
      "include/SZ3/lossless/Lossless.hpp": "5f6d93ec2653a97d9ffaabf2750653e3c20867cf1ea8f1c0887a08b2c8c08271",
      "include/SZ3/lossless/Lossless_zstd.hpp": "cada6f72f71daff386769566a5142f49c33e0495ff638d02063238a4b3bd1abc"
    },
    "modifications": [
      "Unmodified Lossless_zstd and existing A1 Huffman. Extract first-order 1D/2D Lorenzo formula into signed-integer causal predictor; replace lossy overwriting quantizer with exact modulo residual. Feedback is exactly restored original codeword. Huffman table outside final Zstd for separate metadata accounting; not automatic interpolation/regression SZ3."
    ]
  },
  {
    "name": "FPC 1.1",
    "source": "https://userweb.cs.txstate.edu/~burtscher/research/FPC/",
    "source_sha256": "f826ebc3d5aeece2b86bf5062a4ed4122f6605a66c5bfec813ddb44d2fc5843b",
    "license": "Cornell non-commercial research/teaching; full notice in ../FPC-NOTICE.txt and references/FPC.c",
    "modifications": [
      "dedicated.hpp: FCM/DFCM selection, XOR and original 4-bit selector/byte-length prefix retained; uint4/8/16 unsigned codewords replace FP64, width-aware hash, 4096 slots, no arithmetic backend; safe buffered accesses; modified 2026-11-09."
    ]
  },
  {
    "repository": "libsndfile/libsndfile",
    "sha": "72f6af15e8f85157bd622ed45b979025828b7001",
    "license": "LGPL-2.1-or-later",
    "source_sha256": "dee6d75468d156e7402812a66cfcb45ff9c46ad524b052dd81e6c1072b2447f8",
    "modifications": [
      "ima.hpp: extract original IMA step/index tables and quantized reconstruction feedback; use exact external modulo compensation. Arithmetic-code both IMA decisions and corrections. Initialization sample=0,index=0. Not G.726."
    ]
  },
  {
    "repository": "xiph/flac",
    "sha": "59fa3402cb19b6b7c85b916f138cfb03c7b27504",
    "license": "BSD-3-Clause",
    "source_sha256": "7f900f142b3567495147a1a68777b563fbe240186aabdd93c7ec237093895d91",
    "modifications": [
      "predictors.hpp: adapt autocorrelation/Levinson-Durbin recurrence to order 8, training prefix <=8192, bounded reflection coefficients and serialized Q12 coefficients. Decoder uses exact integer math and modulo residual, arithmetic backend. Not a FLAC stream."
    ]
  },
  {
    "name": "PNG filters",
    "source": "https://www.w3.org/TR/2025/REC-png-3-20250624/#9Filters",
    "modifications": [
      "Filters 0..4, original Paeth tie rules; extend byte modulus to complete codeword modulus (4/8/16 bits), row selection and saved mode. Arithmetic backend, no PNG container/DEFLATE."
    ]
  },
  {
    "name": "LTP",
    "source": "https://www.rfc-editor.org/rfc/rfc6716.html#section-4.2.7.6",
    "modifications": [
      "Reference only; own integer one-tap lag/gain adaptation. Not full Opus five-tap SILK or excitation quantizer. All lag/gain parameters serialized."
    ]
  },
  {
    "name": "Motion compensation and intra directional prediction",
    "source": "https://www.itu.int/rec/T-REC-H.264-202108-S/en",
    "modifications": [
      "Reference mechanisms only; own bounded integer block matching and four-direction boundary prediction. 16-row causal reference strips/16x4 blocks; 8x8 intra blocks; not full H.264 syntax, subpixel motion, transforms or quantizers. Physical sample order unchanged, references entirely within independent component."
    ]
  },
  {
    "name": "Delta/XOR/DPCM",
    "source": "https://www.rfc-editor.org/rfc/rfc9639.html#section-9.2.5",
    "modifications": [
      "Own small integer loops: previous-word delta, previous-word XOR, order-2 fixed DPCM. Exact complete-codeword residuals and existing A1 arithmetic backend."
    ]
  }
]
