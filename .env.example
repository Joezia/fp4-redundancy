# Copy to .env and set the model's existing local data directory. No download.
export EFLAB_DATA_DIR="/path/to/eflab"
export MODEL_ID="deepseek-ai/DeepSeek-V4.1-Flash"
export MODEL_REVISION="2cba9e42aa026125f3ed06c6d98c1db82f7ca027"
export SNAPSHOT="$EFLAB_DATA_DIR/hf_cache/hub/models--deepseek-ai--DeepSeek-V4.1-Flash/snapshots/$MODEL_REVISION"
export FP4_RUNS_DIR="$PWD/runs"
